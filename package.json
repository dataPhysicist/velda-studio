{
  "name": "velda-studio",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "description": "Remodel design studio: one measured, editable 3D model of a home. Built on the Pascal editor, deployed as a Toolbelt app page.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --config vite.viewer.config.ts --logLevel warn",
    "build:cdn": "STUDIO_CDN=1 vite build && vite build --config vite.viewer.config.ts --logLevel warn",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:import": "vitest run tests/import",
    "test:e2e": "playwright test",
    "test:perf": "PERF=1 vitest run tests/perf",
    "schema": "npx -y ts-json-schema-generator@2.4.0 --path src/model/types.ts --type Model --no-type-check -o schema/model-v2.schema.json",
    "check": "npm run typecheck && npm run test:unit && npm run test:perf && npm run test:e2e"
  },
  "dependencies": {
    "@pascal-app/core": "1.0.3",
    "@pascal-app/editor": "1.0.3",
    "@pascal-app/nodes": "1.0.3",
    "@pascal-app/viewer": "1.0.3",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "jspdf": "4.2.1",
    "jszip": "3.10.2",
    "lucide-react": "^1.49.0",
    "pdfjs-dist": "6.4.299",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "svg2pdf.js": "2.8.1",
    "three": "^0.186.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "22.20.5",
    "@vitejs/plugin-react": "^6.1.1",
    "jpeg-js": "0.4.4",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.2",
    "vitest": "5.0.5"
  }
}
